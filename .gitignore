.DS_Store

# Transfer artifact (contains plaintext source)
files.zip

# Private gate sources — keep local, never publish (build.js holds the password)
liam/index.source.html
liam/build.js
*.source.html

# Norvège 2026 — receipts are embedded (encrypted) inside index.html behind the
# password gate; keep the raw PDFs local so they aren't served unencrypted.
norvege-2026/*.pdf

# Backend secrets — never publish (DB URL, API keys)
.env
**/.env

# Claude Code local dir & agent worktrees — never track (breaks git if committed)
.claude/

# Norvège 2026 — build script holds the password; keep local
norvege-2026/build.js

# Graded-assessment material — answer keys. This repo IS the live web root
# (janerikmeidell.com), so anything committed here is publicly downloadable.
# Never track question banks with correct answers in them.
**/_private/
